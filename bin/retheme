#!/usr/bin/env bash
# retheme - regenerate every colour artefact from the current wallpaper, then
#           reload each consumer.
#
# usage: retheme [--apply-only] [--no-nvim] [--dry-run] [--wallpaper PATH]
#
#   --apply-only   skip generation, just re-apply what is already on disk.
#                  Used at login so a fresh session matches the current
#                  wallpaper without a matugen run on the critical path.
#   --no-nvim      skip the nvim template + signal (freeze the editor palette).
#   --dry-run      print every command, execute none.
#   --wallpaper P  point the state symlink at P first.
#
# Everything generated lands in $STATE (outside the repo and outside
# ~/.config), so `git status` stays clean however often the wallpaper changes,
# and the nvim submodule can never be dirtied.
set -uo pipefail

STATE="${XDG_STATE_HOME:-$HOME/.local/state}/theme"
LOCK="${XDG_RUNTIME_DIR:-/tmp}/retheme.lock"
SCHEME_TYPE="scheme-tonal-spot"   # M3 baseline; keeps chroma restrained
MODE="dark"
PREFER="saturation"               # REQUIRED: matugen aborts without it when an
                                  # image yields several candidates and there is
                                  # no TTY (i.e. from a keybind or autostart).

APPLY_ONLY=false; DO_NVIM=true; DRY=false
while (($#)); do case "$1" in
  --apply-only) APPLY_ONLY=true ;;
  --no-nvim)    DO_NVIM=false ;;
  --dry-run)    DRY=true ;;
  --wallpaper)  shift; mkdir -p "$STATE"; ln -sfn "$(readlink -f "$1")" "$STATE/wallpaper" ;;
  -h|--help)    sed -n '2,20p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
  *) printf 'retheme: unknown argument %s\n' "$1" >&2; exit 2 ;;
esac; shift; done

run()  { if $DRY; then printf '  + %s\n' "$*"; else "$@"; fi; }
note() { printf '\033[1;36m::\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m!!\033[0m %s\n' "$*" >&2; }

# Serialise: a held-down keybind must not interleave two runs writing $STATE.
exec 9>"$LOCK"
if ! flock -n 9; then warn "another retheme is running"; exit 1; fi

mkdir -p "$STATE"
WALL="$(readlink -f "$STATE/wallpaper" 2>/dev/null || true)"
if [ -z "${WALL:-}" ] || [ ! -r "$WALL" ]; then
  warn "no wallpaper at $STATE/wallpaper - run: wallpaper <path>"; exit 1
fi

# ---------------------------------------------------------------- generate ---
if ! $APPLY_ONLY; then
  note "matugen ($SCHEME_TYPE/$MODE, prefer=$PREFER) <- $(basename "$WALL")"
  # --continue-on-error: one bad template must not block the others.
  run matugen image "$WALL" -t "$SCHEME_TYPE" -m "$MODE" \
        --prefer "$PREFER" --continue-on-error -q
  if ! $DRY && [ ! -s "$STATE/scheme.json" ]; then
    warn "matugen produced no scheme.json - aborting before any reload"; exit 1
  fi
fi

# --------------------------------------------------------------- wallpaper ---
set_wallpaper() {
  # hyprpaper keeps every wallpaper ever preloaded resident, so unload first.
  hyprctl hyprpaper unload all      >/dev/null 2>&1 || true
  hyprctl hyprpaper preload "$1"    >/dev/null 2>&1 || true
  # Empty monitor field = all monitors, matching hyprpaper.conf.
  hyprctl hyprpaper wallpaper ",$1" >/dev/null 2>&1 || true
}
if command -v hyprctl >/dev/null && hyprctl monitors >/dev/null 2>&1; then
  note "wallpaper -> hyprpaper"
  run set_wallpaper "$WALL"
fi

# -------------------------------------------------------------------- hypr ---
if command -v hyprctl >/dev/null && hyprctl monitors >/dev/null 2>&1 \
   && [ -r "$STATE/hypr-colors.conf" ]; then
  note "hyprland borders"
  # `keyword`, not `reload`: applies live and cannot re-fire the
  # hyprland.start autostart handler.
  ab=$(sed -n 's/^active_border=//p'   "$STATE/hypr-colors.conf")
  ib=$(sed -n 's/^inactive_border=//p' "$STATE/hypr-colors.conf")
  bg=$(sed -n 's/^background=//p'      "$STATE/hypr-colors.conf")
  [ -n "$ab" ] && run hyprctl --batch \
    "keyword general:col.active_border $ab ; keyword general:col.inactive_border $ib ; keyword misc:background_color $bg"
fi

# --------------------------------------------------------------- alacritty ---
if [ -r "$STATE/alacritty.toml" ]; then
  note "alacritty"
  # live_config_reload watches imports, but touching the parent is a
  # guaranteed poke and costs nothing.
  run touch "$HOME/.config/alacritty/alacritty.toml"
fi

# -------------------------------------------------------------------- tmux ---
if command -v tmux >/dev/null && [ -r "$STATE/tmux.conf" ]; then
  note "tmux"
  shopt -s nullglob
  for sock in "/tmp/tmux-$(id -u)"/*; do
    [ -S "$sock" ] || continue
    run tmux -S "$sock" source-file "$STATE/tmux.conf"
    # source-file rewrites status-right, wiping agent-inbox's segment. Its
    # entrypoint is idempotent, so just re-run it.
    inbox="$HOME/source/repos/tmux-agent-inbox/agent-inbox.tmux"
    [ -x "$inbox" ] && run tmux -S "$sock" run-shell "$inbox"
  done
  shopt -u nullglob
fi

# -------------------------------------------------------------------- nvim ---
if $DO_NVIM && [ -r "$STATE/nvim-palette.lua" ]; then
  note "nvim (SIGUSR1)"
  run pkill -USR1 -x nvim || true      # no running nvim is not an error
fi

# -------------------------------------------------------------- quickshell ---
if command -v qs >/dev/null && qs ipc -c mg show >/dev/null 2>&1; then
  note "quickshell (mg)"
  # The shell watches scheme.json itself; this is belt-and-braces.
  run qs ipc -c mg call theme reload || true
fi

# ------------------------------------------------------------------ notify ---
src=$(sed -n 's/.*"source": "\([^"]*\)".*/\1/p' "$STATE/scheme.json" 2>/dev/null || echo '?')
if $DRY; then
  note "dry run complete (nothing executed)"
else
  msg="$(basename "$WALL")  -  $src"
  if command -v notify-send >/dev/null; then
    notify-send -a retheme -i "$WALL" -t 3000 "Theme updated" \
      "$msg
New shells pick up zsh/lazygit/rofi colours."
  fi
  note "$msg"
fi
