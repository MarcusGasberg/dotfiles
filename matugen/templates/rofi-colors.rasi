/* GENERATED by matugen - do not edit.
   Fixes a real bug as a side effect: the previous catppuccin.rasi had
   selected-col byte-identical to bg-col, so the selection highlight was
   invisible. selected-col is now primary_container over a surface bg. */
* {
    bg-col:       {{colors.surface.default.hex}};
    bg-col-light: {{colors.surface_container.default.hex}};
    border-col:   {{colors.primary.default.hex}};
    selected-col: {{colors.primary_container.default.hex}};
    blue:         {{colors.primary.default.hex}};
    fg-col:       {{colors.on_surface.default.hex}};
    fg-col2:      {{colors.on_primary_container.default.hex}};
    grey:         {{colors.on_surface_variant.default.hex}};
    width:        600;
}
