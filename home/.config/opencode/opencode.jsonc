{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "chrome-devtools": {
      "type": "local",
      "command": [
        "bunx",
        "-y",
        "chrome-devtools-mcp@latest",
        "--no-usage-statistics"
      ],
    },
    "slaeng": {
      "type": "local",
      "command": [
        "slaeng-mcp"
      ],
      "enabled": true
    }
  },
}
